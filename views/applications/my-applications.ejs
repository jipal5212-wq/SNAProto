<div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">My Applications</h1>
    <p class="text-sm text-gray-500">Track the status of your submitted challenge solutions.</p>
</div>

<% if (applications.length === 0) { %>
    <div class="bg-white p-8 rounded-lg border border-gray-200 text-center shadow-sm">
        <h3 class="text-lg font-medium text-gray-900 mb-2">No Applications Submitted</h3>
        <p class="text-gray-500 mb-4">You haven't applied to any challenges yet.</p>
        <a href="/challenges" class="text-primary font-medium hover:underline">Discover Challenges</a>
    </div>
<% } else { %>
    <div class="bg-white shadow-sm border border-gray-200 rounded-lg overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Challenge</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date Submitted</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Solution Title</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Proposal Doc</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
                <% applications.forEach(app => { %>
                    <tr>
                        <td class="px-6 py-4">
                            <a href="/challenges/<%= app.challenge._id %>" class="text-sm font-medium text-primary hover:underline line-clamp-2">
                                <%= app.challenge.title %>
                            </a>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            <%= new Date(app.submittedAt).toLocaleDateString() %>
                        </td>
                        <td class="px-6 py-4">
                            <div class="text-sm text-gray-900 font-medium"><%= app.solutionTitle %></div>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap text-xs">
                            <% if (app.documentFile) { %>
                                <a href="<%= app.documentFile %>" target="_blank" class="text-primary hover:underline flex items-center gap-1 font-semibold">
                                    <span>📄 View Doc</span>
                                </a>
                            <% } else { %>
                                <span class="text-gray-400 italic">No doc</span>
                            <% } %>
                        </td>
                        <td class="px-6 py-4 whitespace-nowrap">
                            <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full 
                                <%= app.status === 'SHORTLISTED' ? 'bg-green-100 text-green-800' : 
                                   (app.status === 'REJECTED' ? 'bg-red-100 text-red-800' : 
                                   (app.status === 'PILOT_SELECTED' ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800')) %>">
                                <%= app.status %>
                            </span>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
<% } %>
