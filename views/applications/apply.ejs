<div class="mb-6">
    <a href="/challenges/<%= challenge._id %>" class="text-sm text-primary hover:underline flex items-center gap-1 mb-4">
        &larr; Back to Challenge Details
    </a>
    <h1 class="text-2xl font-bold text-gray-900">Submit Application</h1>
    <p class="text-gray-500 mt-1">Applying to: <span class="font-semibold"><%= challenge.title %></span></p>
</div>

<div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <form action="/challenges/<%= challenge._id %>/apply" method="POST" enctype="multipart/form-data" class="p-6 space-y-6">
        
        <!-- Document Upload Section (Primary for RAG) -->
        <div class="p-4 bg-blue-50 border border-blue-200 rounded-lg">
            <div class="flex items-start gap-3">
                <div class="p-2 bg-blue-600 text-white rounded-md text-lg">📄</div>
                <div class="flex-1">
                    <label for="proposalDocument" class="block text-sm font-semibold text-blue-950 mb-1">
                        Upload Solution Proposal Document (PDF / DOCX) *
                    </label>
                    <p class="text-xs text-blue-700 mb-2">
                        Upload your pitch deck or technical proposal. Our AI RAG engine will automatically parse your architecture, TRL level, budget, and statutory compliance (DPIIT/turnover).
                    </p>
                    <input type="file" id="proposalDocument" name="proposalDocument" accept=".pdf,.docx,.doc" class="w-full text-sm text-gray-700 file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-primary file:text-white hover:file:bg-blue-700 cursor-pointer">
                </div>
            </div>
        </div>

        <div>
            <label for="solutionTitle" class="block text-sm font-medium text-gray-700 mb-1">Solution Title *</label>
            <input type="text" id="solutionTitle" name="solutionTitle" required class="w-full border border-gray-300 rounded-md p-2" placeholder="Name your proposed solution">
        </div>

        <div>
            <label for="solutionDescription" class="block text-sm font-medium text-gray-700 mb-1">Solution Description *</label>
            <textarea id="solutionDescription" name="solutionDescription" required rows="3" class="w-full border border-gray-300 rounded-md p-2" placeholder="Provide a high-level overview of how your solution addresses the problem."></textarea>
        </div>
        
        <div>
            <label for="technicalApproach" class="block text-sm font-medium text-gray-700 mb-1">Technical Approach (Optional if detailed in document)</label>
            <textarea id="technicalApproach" name="technicalApproach" rows="3" class="w-full border border-gray-300 rounded-md p-2" placeholder="Describe the technology stack, architecture, and core components."></textarea>
        </div>

        <div>
            <label for="implementationPlan" class="block text-sm font-medium text-gray-700 mb-1">Implementation Plan for Pilot</label>
            <textarea id="implementationPlan" name="implementationPlan" rows="2" class="w-full border border-gray-300 rounded-md p-2" placeholder="How would you roll this out during the expected pilot duration?"></textarea>
        </div>

        <div>
            <label for="expectedImpact" class="block text-sm font-medium text-gray-700 mb-1">Expected Impact vs KPIs</label>
            <textarea id="expectedImpact" name="expectedImpact" rows="2" class="w-full border border-gray-300 rounded-md p-2" placeholder="How will your solution achieve the challenge target?"></textarea>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label for="estimatedCost" class="block text-sm font-medium text-gray-700 mb-1">Estimated Cost (INR)</label>
                <input type="number" id="estimatedCost" name="estimatedCost" class="w-full border border-gray-300 rounded-md p-2" placeholder="E.g., 500000">
            </div>
            <div>
                <label for="pilotRequirements" class="block text-sm font-medium text-gray-700 mb-1">Government Resources Required</label>
                <input type="text" id="pilotRequirements" name="pilotRequirements" class="w-full border border-gray-300 rounded-md p-2" placeholder="E.g., SCADA API access, field test site">
            </div>
        </div>

        <div class="pt-4 border-t border-gray-200 flex justify-end">
            <button type="submit" class="bg-primary text-white px-6 py-2 rounded-md font-medium hover:bg-blue-700 transition-colors">
                Submit Application
            </button>
        </div>
    </form>
</div>
