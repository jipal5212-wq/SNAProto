<div class="mb-6">
    <a href="/government/challenges/<%= challenge._id %>/applications" class="text-sm text-primary hover:underline flex items-center gap-1 mb-4">
        &larr; Back to Applications
    </a>
    <h1 class="text-2xl font-bold text-gray-900">Application Ranking</h1>
    <p class="text-gray-500 mt-1">Challenge: <%= challenge.title %></p>
</div>

<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 mb-6">
    <div class="flex items-center gap-4 text-sm text-gray-600">
        <div><span class="font-bold text-gray-900">Sorting:</span> Ranked primarily by Evaluation Score (average of evaluator scores), then by AI Match Score.</div>
    </div>
</div>

<div class="bg-white shadow-sm border border-gray-200 rounded-lg overflow-hidden">
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider w-16">Rank</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Startup</th>
                <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">AI Match Score</th>
                <th scope="col" class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Evaluation Score</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Action</th>
            </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
            <% rankedApplications.forEach((app, index) => { %>
                <tr class="<%= index === 0 ? 'bg-yellow-50' : '' %>">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="flex items-center justify-center w-8 h-8 rounded-full <%= index === 0 ? 'bg-yellow-400 text-white font-bold' : (index < 3 ? 'bg-gray-200 text-gray-700 font-medium' : 'bg-transparent text-gray-500') %>">
                            <%= index + 1 %>
                        </div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-bold text-gray-900"><%= app.startup ? app.startup.name : 'Unknown' %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-center">
                        <span class="text-sm text-gray-600"><%= app.matchScore %>%</span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-center">
                        <% if (app.evalScore !== null) { %>
                            <span class="px-3 py-1 inline-flex text-sm leading-5 font-bold rounded-full bg-indigo-100 text-indigo-800"><%= app.evalScore %></span>
                        <% } else { %>
                            <span class="text-xs text-gray-400 italic">No score yet</span>
                        <% } %>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full 
                            <%= app.status === 'SHORTLISTED' ? 'bg-green-100 text-green-800' : 
                               (app.status === 'REJECTED' ? 'bg-red-100 text-red-800' : 
                               (app.status === 'PILOT_SELECTED' ? 'bg-purple-100 text-purple-800' : 'bg-gray-100 text-gray-800')) %>">
                            <%= app.status %>
                        </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                        <% if (app.status === 'SHORTLISTED') { %>
                            <a href="/government/pilots/create?challenge=<%= challenge._id %>&startup=<%= app.startup ? app.startup._id : '' %>" class="text-white bg-primary hover:bg-blue-700 px-3 py-1 rounded">Select for Pilot</a>
                        <% } else { %>
                            <a href="/government/applications/<%= app._id %>/evaluate" class="text-primary hover:text-blue-900">View Details</a>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>
