<div class="mb-6 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
        <a href="/government/challenges/<%= challenge._id %>/applications" class="text-sm text-primary hover:underline flex items-center gap-1 mb-2">
            &larr; Back to Applications
        </a>
        <h1 class="text-2xl font-bold text-gray-900 flex items-center gap-3">
            <span>AI Shortlisting & Ranking</span>
            <span class="text-xs px-2.5 py-1 rounded-full font-semibold <%= isRagAvailable ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                <%= isRagAvailable ? '● RAG Engine Online' : '○ RAG Offline' %>
            </span>
        </h1>
        <p class="text-gray-500 mt-1">Challenge: <span class="font-semibold text-gray-800"><%= challenge.title %></span></p>
    </div>

    <!-- Actions & RAG Trigger -->
    <div class="flex items-center gap-3">
        <form action="/government/challenges/<%= challenge._id %>/rag-shortlist" method="POST" onsubmit="this.querySelector('button').disabled=true; this.querySelector('button').innerText='Running AI Evaluation...';">
            <button type="submit" class="bg-gradient-to-r from-blue-600 to-indigo-700 text-white font-semibold px-5 py-2.5 rounded-lg shadow hover:from-blue-700 hover:to-indigo-800 flex items-center gap-2 transition-all">
                <span>⚡ Run AI RAG Shortlisting</span>
            </button>
        </form>
    </div>
</div>

<!-- Semantic Search Card -->
<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5 mb-6">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="flex-1">
            <h3 class="text-sm font-bold text-gray-900 uppercase tracking-wider mb-1">🔍 Cross-Proposal Semantic Search (ChromaDB)</h3>
            <p class="text-xs text-gray-500">Query across all parsed startup pitch decks and technical proposals (e.g., "IoT acoustic leak detection", "SCADA integration", "radar remote sensing").</p>
        </div>
        <form action="/government/challenges/<%= challenge._id %>/rag-search" method="POST" class="flex items-center gap-2 w-full md:w-auto">
            <input type="text" name="query" value="<%= searchQuery || '' %>" placeholder="Enter keywords or requirements..." required class="border border-gray-300 rounded-md px-3 py-2 text-sm w-full md:w-80 focus:ring-2 focus:ring-primary outline-none">
            <button type="submit" class="bg-gray-800 hover:bg-gray-900 text-white px-4 py-2 rounded-md text-sm font-medium transition-colors">Search</button>
        </form>
    </div>

    <!-- Search Results Display if available -->
    <% if (searchResults && searchResults.length > 0) { %>
        <div class="mt-4 pt-4 border-t border-gray-100">
            <div class="flex items-center justify-between mb-3">
                <span class="text-xs font-semibold text-gray-700">Semantic matches for "<%= searchQuery %>":</span>
                <span class="text-xs text-gray-500"><%= searchResults.length %> chunk(s) found</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <% searchResults.forEach(r => { %>
                    <div class="bg-gray-50 border border-gray-200 rounded-md p-3 text-xs">
                        <div class="flex justify-between font-bold text-gray-800 mb-1">
                            <span>🏢 <%= r.startup_name %></span>
                            <span class="text-indigo-600">Relevance: <%= (r.similarity_score * 100).toFixed(1) %>%</span>
                        </div>
                        <p class="text-gray-600 line-clamp-3"><%= r.chunk %></p>
                    </div>
                <% }) %>
            </div>
        </div>
    <% } %>
</div>

<!-- Info banner: 8-Dimension Evaluation Rubric -->
<div class="bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-xl p-4 mb-6 text-xs text-blue-950 shadow-sm">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-2 mb-3">
        <div class="font-bold text-sm text-blue-900 flex items-center gap-2">
            <span>🏛️</span>
            <span>Government Multi-Dimensional AI Procurement Rubric (100% Total)</span>
        </div>
        <div class="inline-flex items-center gap-1.5 bg-blue-100/80 text-blue-800 px-3 py-1 rounded-full font-semibold text-[11px]">
            <span>✓ Logically Viable & Doable Filter Active</span>
        </div>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-2 pt-2 border-t border-blue-200/60 text-[11px]">
        <div class="bg-white/80 p-2 rounded border border-blue-100 shadow-2xs">
            <span class="text-gray-500 block">Problem / Technical Fit</span>
            <span class="font-bold text-blue-900">25% Weight</span>
        </div>
        <div class="bg-white/80 p-2 rounded border border-blue-100 shadow-2xs">
            <span class="text-gray-500 block">Expected Impact</span>
            <span class="font-bold text-blue-900">20% Weight</span>
        </div>
        <div class="bg-white/80 p-2 rounded border border-blue-100 shadow-2xs">
            <span class="text-gray-500 block">Feasibility of Implementation</span>
            <span class="font-bold text-blue-900">15% Weight</span>
        </div>
        <div class="bg-white/80 p-2 rounded border border-blue-100 shadow-2xs">
            <span class="text-gray-500 block">Cost Effectiveness</span>
            <span class="font-bold text-blue-900">10% Weight</span>
        </div>
        <div class="bg-white/80 p-2 rounded border border-blue-100 shadow-2xs">
            <span class="text-gray-500 block">Scalability</span>
            <span class="font-bold text-blue-900">10% Weight</span>
        </div>
        <div class="bg-white/80 p-2 rounded border border-blue-100 shadow-2xs">
            <span class="text-gray-500 block">Security & Data Privacy</span>
            <span class="font-bold text-blue-900">10% Weight</span>
        </div>
        <div class="bg-white/80 p-2 rounded border border-blue-100 shadow-2xs">
            <span class="text-gray-500 block">Startup Capability / Team</span>
            <span class="font-bold text-blue-900">5% Weight</span>
        </div>
        <div class="bg-white/80 p-2 rounded border border-blue-100 shadow-2xs">
            <span class="text-gray-500 block">Innovation</span>
            <span class="font-bold text-blue-900">5% Weight</span>
        </div>
    </div>
</div>

<!-- Ranking Table -->
<div class="bg-white shadow-sm border border-gray-200 rounded-lg overflow-hidden">
    <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 text-xs">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-4 py-3 text-left font-semibold text-gray-600 uppercase tracking-wider w-12">Rank</th>
                    <th class="px-4 py-3 text-left font-semibold text-gray-600 uppercase tracking-wider">Startup & Proposal</th>
                    <th class="px-4 py-3 text-center font-semibold text-gray-600 uppercase tracking-wider">Statutory Eligibility</th>
                    <th class="px-4 py-3 text-center font-semibold text-gray-600 uppercase tracking-wider">Viability / Doability</th>
                    <th class="px-4 py-3 text-center font-semibold text-gray-600 uppercase tracking-wider">AI Score (0-10)</th>
                    <th class="px-4 py-3 text-left font-semibold text-gray-600 uppercase tracking-wider">8-Parameter Scoring (1-5)</th>
                    <th class="px-4 py-3 text-left font-semibold text-gray-600 uppercase tracking-wider">Consistency Flags</th>
                    <th class="px-4 py-3 text-left font-semibold text-gray-600 uppercase tracking-wider">Status</th>
                    <th class="px-4 py-3 text-right font-semibold text-gray-600 uppercase tracking-wider">Procurement Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
                <% rankedApplications.forEach((app, index) => { %>
                    <tr class="<%= index === 0 ? 'bg-amber-50/50 hover:bg-amber-50' : 'hover:bg-gray-50' %> transition-colors">
                        <!-- Rank -->
                        <td class="px-4 py-4 whitespace-nowrap text-center">
                            <% if (index === 0) { %>
                                <div class="w-8 h-8 rounded-full bg-amber-400 text-white font-extrabold flex items-center justify-center mx-auto shadow-sm">1</div>
                            <% } else if (index === 1) { %>
                                <div class="w-8 h-8 rounded-full bg-slate-300 text-slate-800 font-bold flex items-center justify-center mx-auto">2</div>
                            <% } else if (index === 2) { %>
                                <div class="w-8 h-8 rounded-full bg-amber-700/60 text-white font-bold flex items-center justify-center mx-auto">3</div>
                            <% } else { %>
                                <span class="font-medium text-gray-500"><%= index + 1 %></span>
                            <% } %>
                        </td>

                        <!-- Startup & Proposal -->
                        <td class="px-4 py-4">
                            <div class="font-bold text-gray-900 text-sm"><%= app.startup ? app.startup.name : 'Unknown Startup' %></div>
                            <div class="text-gray-600 font-medium"><%= app.solutionTitle %></div>
                            <% if (app.documentFile) { %>
                                <a href="<%= app.documentFile %>" target="_blank" class="inline-flex items-center gap-1 text-primary hover:underline mt-1 font-semibold">
                                    <span>📎 View Proposal Doc</span>
                                </a>
                            <% } %>
                        </td>

                        <!-- Statutory Eligibility -->
                        <td class="px-4 py-4 text-center whitespace-nowrap">
                            <% if (app.ragEligible) { %>
                                <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                    ✓ DPIIT Eligible
                                </span>
                            <% } else { %>
                                <span class="px-2.5 py-1 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800" title="<%= app.ragEligibilityReason %>">
                                    ✕ Ineligible
                                </span>
                                <div class="text-[10px] text-red-600 mt-1 max-w-[140px] truncate"><%= app.ragEligibilityReason %></div>
                            <% } %>
                        </td>

                        <!-- Viability / Doability -->
                        <td class="px-4 py-4 text-center whitespace-nowrap">
                            <% if (app.ragIsDoable !== false) { %>
                                <span class="px-2 py-0.5 inline-flex text-[11px] font-bold rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200" title="<%= app.ragDoabilityReason || 'Verified feasible' %>">
                                    ✓ Doable
                                </span>
                            <% } else { %>
                                <span class="px-2 py-0.5 inline-flex text-[11px] font-bold rounded-full bg-rose-100 text-rose-800 border border-rose-200" title="<%= app.ragDoabilityReason %>">
                                    ✕ Infeasible
                                </span>
                            <% } %>
                        </td>

                        <!-- AI RAG Score -->
                        <td class="px-4 py-4 text-center whitespace-nowrap">
                            <% if (app.ragScore !== null && app.ragScore !== undefined) { %>
                                <div class="inline-flex flex-col items-center">
                                    <span class="text-base font-extrabold px-3 py-1 rounded-lg <%= app.ragScore >= 7.5 ? 'bg-emerald-100 text-emerald-800 border border-emerald-300' : (app.ragScore >= 5.0 ? 'bg-blue-100 text-blue-800 border border-blue-200' : 'bg-rose-100 text-rose-800 border border-rose-200') %>">
                                        <%= app.ragScore %> / 10
                                    </span>
                                </div>
                            <% } else { %>
                                <span class="text-gray-400 italic">Not evaluated</span>
                            <% } %>
                        </td>

                        <!-- 8-Parameter Breakdown -->
                        <td class="px-4 py-4">
                            <% const d = app.ragDimensions || {}; %>
                            <% if (d.technicalFit || d.relevance) { %>
                                <div class="w-64 space-y-1 bg-gray-50/70 p-2 rounded-lg border border-gray-100">
                                    <div class="flex justify-between text-[11px]">
                                        <span class="text-gray-600">Technical Fit <span class="text-gray-400">(25%)</span>:</span>
                                        <span class="font-bold text-gray-900"><%= d.technicalFit || d.relevance %>/5</span>
                                    </div>
                                    <div class="flex justify-between text-[11px]">
                                        <span class="text-gray-600">Expected Impact <span class="text-gray-400">(20%)</span>:</span>
                                        <span class="font-bold text-gray-900"><%= d.expectedImpact || d.relevance %>/5</span>
                                    </div>
                                    <div class="flex justify-between text-[11px]">
                                        <span class="text-gray-600">Feasibility <span class="text-gray-400">(15%)</span>:</span>
                                        <span class="font-bold text-gray-900"><%= d.feasibility %>/5</span>
                                    </div>
                                    <div class="flex justify-between text-[11px]">
                                        <span class="text-gray-600">Cost Effectiveness <span class="text-gray-400">(10%)</span>:</span>
                                        <span class="font-bold text-gray-900"><%= d.costEffectiveness || d.feasibility %>/5</span>
                                    </div>
                                    <div class="flex justify-between text-[11px]">
                                        <span class="text-gray-600">Scalability <span class="text-gray-400">(10%)</span>:</span>
                                        <span class="font-bold text-gray-900"><%= d.scalability || 3 %>/5</span>
                                    </div>
                                    <div class="flex justify-between text-[11px]">
                                        <span class="text-gray-600">Security & Privacy <span class="text-gray-400">(10%)</span>:</span>
                                        <span class="font-bold text-gray-900"><%= d.securityPrivacy || 4 %>/5</span>
                                    </div>
                                    <div class="flex justify-between text-[11px]">
                                        <span class="text-gray-600">Team Capability <span class="text-gray-400">(5%)</span>:</span>
                                        <span class="font-bold text-gray-900"><%= d.teamCapability || d.teamCredibility %>/5</span>
                                    </div>
                                    <div class="flex justify-between text-[11px]">
                                        <span class="text-gray-600">Innovation <span class="text-gray-400">(5%)</span>:</span>
                                        <span class="font-bold text-gray-900"><%= d.innovation %>/5</span>
                                    </div>

                                    <!-- Justification expander -->
                                    <% if (app.ragJustifications && Object.keys(app.ragJustifications).length > 0) { %>
                                        <details class="mt-2 pt-1 border-t border-gray-200 text-[10px] text-indigo-600 cursor-pointer">
                                            <summary class="hover:underline font-semibold">View AI Justifications</summary>
                                            <div class="mt-1 p-2 bg-white rounded border border-gray-200 text-gray-700 space-y-1.5 shadow-2xs">
                                                <% for (const [dim, just] of Object.entries(app.ragJustifications)) { %>
                                                    <div><strong class="text-gray-900 capitalize"><%= dim.replace(/_/g, ' ') %>:</strong> <%= just %></div>
                                                <% } %>
                                            </div>
                                        </details>
                                    <% } %>
                                </div>
                            <% } else { %>
                                <span class="text-gray-400 italic">—</span>
                            <% } %>
                        </td>

                        <!-- Consistency Flags -->
                        <td class="px-4 py-4">
                            <% if (app.ragConsistencyFlags && app.ragConsistencyFlags.length > 0) { %>
                                <div class="space-y-1">
                                    <% app.ragConsistencyFlags.forEach(flag => { %>
                                        <span class="inline-block bg-amber-100 text-amber-900 border border-amber-300 text-[10px] px-2 py-0.5 rounded">
                                            ⚠️ <%= flag %>
                                        </span>
                                    <% }) %>
                                </div>
                            <% } else { %>
                                <span class="text-green-600 font-semibold text-[11px]">✓ No Contradictions</span>
                            <% } %>
                        </td>

                        <!-- Application Status -->
                        <td class="px-4 py-4 whitespace-nowrap">
                            <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full 
                                <%= app.status === 'SHORTLISTED' ? 'bg-green-100 text-green-800' : 
                                   (app.status === 'REJECTED' ? 'bg-red-100 text-red-800' : 
                                   (app.status === 'PILOT_SELECTED' ? 'bg-purple-100 text-purple-800' : 'bg-gray-100 text-gray-800')) %>">
                                <%= app.status %>
                            </span>
                        </td>

                        <!-- Action -->
                        <td class="px-4 py-4 whitespace-nowrap text-right text-xs font-medium">
                            <div class="flex items-center justify-end gap-2">
                                <a href="/government/applications/<%= app._id %>/evaluate" class="text-gray-600 hover:text-gray-900 border border-gray-300 px-2.5 py-1.5 rounded hover:bg-gray-100">
                                    Manual Review
                                </a>
                                <% if (app.status === 'SHORTLISTED' || (app.ragScore && app.ragScore >= 5.0 && app.ragEligible)) { %>
                                    <a href="/government/pilots/create?challenge=<%= challenge._id %>&startup=<%= app.startup ? app.startup._id : '' %>" class="text-white bg-primary hover:bg-blue-700 px-3 py-1.5 rounded font-semibold shadow-sm">
                                        Select for Pilot &rarr;
                                    </a>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
