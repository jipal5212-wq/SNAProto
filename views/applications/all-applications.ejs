<div class="mb-6">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">Department Applications</h1>
            <p class="text-gray-500 mt-1">Review, score, and shortlist startup submissions across all active challenges</p>
        </div>
        <div class="flex items-center gap-3">
            <a href="/government/challenges" class="bg-white border border-gray-300 hover:bg-gray-50 text-gray-700 px-4 py-2 rounded-md font-medium text-sm transition-colors">
                View Challenges
            </a>
            <a href="/government/pilots" class="bg-primary hover:bg-blue-700 text-white px-4 py-2 rounded-md font-medium text-sm transition-colors">
                Active Pilots
            </a>
        </div>
    </div>
</div>

<% if (!applications || applications.length === 0) { %>
    <div class="bg-white p-12 rounded-xl border border-gray-200 text-center shadow-sm">
        <div class="w-16 h-16 bg-blue-50 text-primary rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
        </div>
        <h3 class="text-lg font-bold text-gray-900 mb-1">No Applications Received Yet</h3>
        <p class="text-gray-500 max-w-md mx-auto mb-6">Startups have not yet submitted proposals for your department's challenges. Ensure your challenges are published to the marketplace.</p>
        <a href="/government/challenges" class="inline-flex items-center px-4 py-2 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-primary hover:bg-blue-700">
            Check Challenge Status
        </a>
    </div>
<% } else { %>
    <div class="bg-white shadow-sm border border-gray-200 rounded-xl overflow-hidden">
        <div class="p-4 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center">
            <span class="text-sm font-semibold text-gray-700">Total Submissions: <span class="text-primary font-bold"><%= applications.length %></span></span>
            <div class="text-xs text-gray-500">Sorted by newest submission</div>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Startup & Solution</th>
                        <th scope="col" class="px-6 py-3.5 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Target Challenge</th>
                        <th scope="col" class="px-6 py-3.5 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Match Score</th>
                        <th scope="col" class="px-6 py-3.5 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                        <th scope="col" class="px-6 py-3.5 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-100">
                    <% applications.forEach(app => { %>
                        <tr class="hover:bg-gray-50/75 transition-colors">
                            <td class="px-6 py-4">
                                <div class="font-bold text-gray-900"><%= app.startup ? app.startup.name : 'Unknown Startup' %></div>
                                <div class="text-sm font-medium text-primary mt-0.5"><%= app.solutionTitle %></div>
                                <div class="text-xs text-gray-500 mt-1">Submitted <%= new Date(app.submittedAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' }) %></div>
                            </td>
                            <td class="px-6 py-4">
                                <% if (app.challenge) { %>
                                    <a href="/government/challenges/<%= app.challenge._id %>" class="text-sm font-medium text-gray-900 hover:text-primary transition-colors line-clamp-2">
                                        <%= app.challenge.title %>
                                    </a>
                                    <span class="inline-block mt-1 px-2 py-0.5 text-xs rounded bg-gray-100 text-gray-600">
                                        <%= app.challenge.sector || 'General' %>
                                    </span>
                                <% } else { %>
                                    <span class="text-sm text-gray-400 italic">Unassigned Challenge</span>
                                <% } %>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <span class="px-2.5 py-1 inline-flex text-xs font-bold rounded-full <%= (app.matchScore || 0) >= 80 ? 'bg-green-100 text-green-800' : ((app.matchScore || 0) >= 60 ? 'bg-blue-100 text-blue-800' : 'bg-gray-100 text-gray-700') %>">
                                    <%= app.matchScore || 0 %>%
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-center">
                                <span class="px-2.5 py-1 inline-flex text-xs font-semibold rounded-full 
                                    <%= app.status === 'SHORTLISTED' ? 'bg-green-100 text-green-800' : 
                                       (app.status === 'REJECTED' ? 'bg-red-100 text-red-800' : 
                                       (app.status === 'PILOT_SELECTED' ? 'bg-purple-100 text-purple-800' : 
                                       (app.status === 'UNDER_REVIEW' ? 'bg-yellow-100 text-yellow-800' : 'bg-blue-50 text-blue-700'))) %>">
                                    <%= app.status ? app.status.replace(/_/g, ' ') : 'SUBMITTED' %>
                                </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium space-x-2">
                                <a href="/government/applications/<%= app._id %>/evaluate" class="inline-flex items-center px-3 py-1.5 bg-primary hover:bg-blue-700 text-white rounded-md text-xs font-semibold shadow-sm transition-colors">
                                    Evaluate
                                </a>
                                <% if (app.challenge) { %>
                                    <a href="/government/challenges/<%= app.challenge._id %>/ranking" class="inline-flex items-center px-3 py-1.5 border border-gray-300 hover:bg-gray-50 text-gray-700 rounded-md text-xs font-medium transition-colors">
                                        Rankings
                                    </a>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
<% } %>
