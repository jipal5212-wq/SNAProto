                    </label>
                    <button id="btnRunShortlist" onclick="loadShortlist()" class="bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-700 hover:to-blue-700 text-white text-xs font-bold px-4 py-2.5 rounded-lg shadow-sm flex items-center gap-2 transition-all">
                        <span id="shortlistBtnIcon">⚡</span>
                        <span id="shortlistBtnText">Run AI Shortlisting</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Rubric Summary Bar -->
        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2 text-center text-xs">
            <div class="bg-indigo-50/60 border border-indigo-100 rounded-lg p-2">
                <div class="text-[10px] text-indigo-700 font-medium truncate">Technical Fit</div>
                <div class="text-sm font-black text-indigo-900">25%</div>
            </div>
            <div class="bg-blue-50/60 border border-blue-100 rounded-lg p-2">
