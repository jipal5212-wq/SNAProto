            </div>
            <div class="bg-amber-50/60 border border-amber-100 rounded-lg p-2">
                <div class="text-[10px] text-amber-700 font-medium truncate">Cost Effective</div>
                <div class="text-sm font-black text-amber-900">10%</div>
            </div>
            <div class="bg-teal-50/60 border border-teal-100 rounded-lg p-2">
                <div class="text-[10px] text-teal-700 font-medium truncate">Scalability</div>
                <div class="text-sm font-black text-teal-900">10%</div>
            </div>
            <div class="bg-purple-50/60 border border-purple-100 rounded-lg p-2">
                <div class="text-[10px] text-purple-700 font-medium truncate">Security & Privacy</div>
                <div class="text-sm font-black text-purple-900">10%</div>
            </div>
            <div class="bg-sky-50/60 border border-sky-100 rounded-lg p-2">
                <div class="text-[10px] text-sky-700 font-medium truncate">Team Capability</div>
                <div class="text-sm font-black text-sky-900">5%</div>
            </div>
            <div class="bg-rose-50/60 border border-rose-100 rounded-lg p-2">
                <div class="text-[10px] text-rose-700 font-medium truncate">Innovation</div>
                <div class="text-sm font-black text-rose-900">5%</div>
            </div>
        </div>

        <!-- Shortlist Results Area -->
        <div id="shortlistContainer" class="bg-white rounded-xl shadow-xs border border-gray-200 overflow-hidden">
            <div class="p-8 text-center" id="shortlistEmptyState">
                <div class="w-12 h-12 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center mx-auto mb-3 text-xl">
                    📊
                </div>
                <h3 class="text-sm font-bold text-gray-800">Ready to Evaluate Proposals</h3>
                <p class="text-xs text-gray-500 max-w-md mx-auto mt-1">
                    Click <strong>"Run AI Shortlisting"</strong> to retrieve candidate proposals from ChromaDB, execute multi-dimensional scoring, and audit internal contradictions.
                </p>
            </div>

            <!-- Table loaded via JS -->
            <div id="shortlistTableWrap" class="hidden overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead class="bg-slate-50 border-b border-gray-200 text-gray-600 font-semibold uppercase tracking-wider">
                        <tr>
                            <th class="px-4 py-3 w-12 text-center">Rank</th>
                            <th class="px-4 py-3">Startup & Proposal</th>
                            <th class="px-4 py-3 text-center">Final Score</th>
                            <th class="px-4 py-3">Dimension Scores Breakdown</th>
                            <th class="px-4 py-3 text-center">Doability & Integrity</th>
                            <th class="px-4 py-3 text-right">Actions</th>
                        </tr>
