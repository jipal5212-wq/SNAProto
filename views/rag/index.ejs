<div class="space-y-6">
    <!-- Header Banner -->
    <div class="bg-gradient-to-r from-slate-900 via-indigo-950 to-blue-900 rounded-2xl p-6 text-white shadow-lg border border-indigo-800/40 relative overflow-hidden">
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 relative z-10">
            <div>
                <div class="flex items-center gap-2 mb-2">
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-indigo-500/20 text-indigo-300 border border-indigo-400/30">
                        ⚡ Retrieval-Augmented Generation (RAG)
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-400/30 flex items-center gap-1">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        Pipeline Online
                    </span>
                </div>
                <h1 class="text-2xl sm:text-3xl font-black tracking-tight text-white flex items-center gap-2">
                    <span>AI Procurement Intelligence Hub</span>
                </h1>
                <p class="text-sm text-slate-300 max-w-2xl mt-1.5">
                    Automated, audit-proof proposal scrutiny powered by dense vector search in ChromaDB, 8-dimension multi-criteria scoring, and automated bluff & contradiction detection.
                </p>
            </div>

            <!-- Diagnostics Pills -->
            <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-2 gap-2 text-xs">
                <div class="bg-slate-800/80 backdrop-blur border border-slate-700/60 rounded-xl p-2.5">
                    <div class="text-slate-400 text-[11px]">Vector Store</div>
                    <div class="font-bold text-slate-100 flex items-center gap-1.5 mt-0.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                        ChromaDB (HNSW)
                    </div>
                </div>
                <div class="bg-slate-800/80 backdrop-blur border border-slate-700/60 rounded-xl p-2.5">
                    <div class="text-slate-400 text-[11px]">Dense Embeddings</div>
                    <div class="font-bold text-slate-100 flex items-center gap-1.5 mt-0.5">
                        <span class="w-2 h-2 rounded-full bg-blue-400"></span>
                        all-MiniLM-L6-v2 (384-D)
                    </div>
                </div>
                <div class="bg-slate-800/80 backdrop-blur border border-slate-700/60 rounded-xl p-2.5">
                    <div class="text-slate-400 text-[11px]">LLM Evaluator</div>
                    <div class="font-bold text-slate-100 flex items-center gap-1.5 mt-0.5">
                        <span class="w-2 h-2 rounded-full bg-purple-400"></span>
                        Gemini 3.5 Flash
                    </div>
                </div>
                <div class="bg-slate-800/80 backdrop-blur border border-slate-700/60 rounded-xl p-2.5">
                    <div class="text-slate-400 text-[11px]">Pre-Filter Gate</div>
                    <div class="font-bold text-slate-100 flex items-center gap-1.5 mt-0.5">
                        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                        DPIIT + ₹100Cr Cap
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Challenge Context Selector Bar -->
    <div class="bg-white rounded-xl shadow-xs border border-gray-200 p-4">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div class="flex items-center gap-3 flex-1">
                <div class="w-10 h-10 rounded-lg bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 font-bold text-lg flex-shrink-0">
                    🏛️
                </div>
                <div class="flex-1 min-w-0">
                    <label for="challengeSelector" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1">
                        Select Active Challenge / Procurement Problem
                    </label>
                    <select id="challengeSelector" class="w-full bg-gray-50 border border-gray-300 rounded-lg px-3 py-2 text-sm font-medium text-gray-800 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition-all">
                        <% if (challenges && challenges.length > 0) { %>
                            <% challenges.forEach((ch) => { %>
                                <option value="<%= ch._id %>" 
                                    data-title="<%= ch.title %>"
                                    data-ragid="<%= ch.ragProblemId || '' %>"
                                    data-problem="<%= (ch.problemStatement || ch.rawProblem || '').replace(/"/g, '&quot;') %>"
                                    <%= (selectedChallengeId && selectedChallengeId.toString() === ch._id.toString()) ? 'selected' : '' %>>
                                    <%= ch.title %> <%= ch.ragProblemId ? `[RAG ID: #${ch.ragProblemId}]` : '[Unsynced]' %>
                                </option>
                            <% }) %>
                        <% } else { %>
                            <option value="">No challenges found in database</option>
                        <% } %>
                        <option value="custom">✍️ Enter Custom Problem Statement...</option>
                    </select>
                </div>
            </div>

            <div class="flex items-center gap-2">
                <div id="ragProblemBadge" class="px-3 py-2 bg-indigo-50 border border-indigo-200 rounded-lg text-xs font-bold text-indigo-800 flex items-center gap-1.5 whitespace-nowrap">
                    <span>Active Problem ID:</span>
                    <span id="activeProblemIdDisplay" class="bg-indigo-600 text-white px-2 py-0.5 rounded font-mono">1</span>
                </div>
                <button id="btnSyncChallenge" class="px-3 py-2 bg-slate-800 hover:bg-slate-900 text-white text-xs font-semibold rounded-lg shadow-xs transition-colors flex items-center gap-1 whitespace-nowrap">
                    <span>🔄 Sync to RAG</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <div class="border-b border-gray-200">
        <nav class="flex space-x-2 sm:space-x-4 overflow-x-auto pb-px" aria-label="Tabs">
            <button onclick="switchTab('tab-shortlist')" id="tabBtn-shortlist" class="tab-btn px-4 py-3 text-sm font-bold border-b-2 border-indigo-600 text-indigo-600 flex items-center gap-2 whitespace-nowrap">
                <span>⚡ AI Shortlisting & Matrix</span>
                <span id="shortlistCountBadge" class="bg-indigo-100 text-indigo-800 text-[10px] font-bold px-2 py-0.5 rounded-full">Top 15</span>
            </button>
            <button onclick="switchTab('tab-search')" id="tabBtn-search" class="tab-btn px-4 py-3 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 flex items-center gap-2 whitespace-nowrap">
                <span>🔍 Semantic Vector Search</span>
            </button>
            <button onclick="switchTab('tab-upload')" id="tabBtn-upload" class="tab-btn px-4 py-3 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 flex items-center gap-2 whitespace-nowrap">
                <span>📤 Proposal Ingestion & Chunker</span>
            </button>
            <button onclick="switchTab('tab-extractor')" id="tabBtn-extractor" class="tab-btn px-4 py-3 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 flex items-center gap-2 whitespace-nowrap">
                <span>🏛️ Problem Ontologist</span>
            </button>
            <button onclick="switchTab('tab-architecture')" id="tabBtn-architecture" class="tab-btn px-4 py-3 text-sm font-semibold border-b-2 border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300 flex items-center gap-2 whitespace-nowrap">
                <span>📐 Pipeline Math & Proof</span>
            </button>
        </nav>
    </div>

    <!-- ======================================================== -->
    <!-- TAB 1: AI SHORTLISTING & 8-DIMENSION EVALUATION MATRIX -->
    <!-- ======================================================== -->
    <div id="tab-shortlist" class="tab-content space-y-6">
        <!-- Control Bar -->
        <div class="bg-white rounded-xl shadow-xs border border-gray-200 p-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h2 class="text-base font-bold text-gray-900 flex items-center gap-2">
                        <span>Multi-Dimensional AI Evaluation & Ranked Shortlist</span>
                    </h2>
                    <p class="text-xs text-gray-500 mt-0.5">
                        Aggregates technical fit (25%), impact (20%), feasibility (15%), cost (10%), scalability (10%), security (10%), team (5%), and innovation (5%) with automated contradiction penalties.
                    </p>
                </div>
                <div class="flex items-center gap-3">
                    <label class="flex items-center gap-2 text-xs text-gray-600 cursor-pointer select-none">
