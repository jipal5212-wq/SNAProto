<div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Innovation Challenges</h1>
    <p class="text-gray-500 mt-1">Discover government operational problems and submit your innovative solutions.</p>
</div>

<% if (challenges.length === 0) { %>
    <div class="bg-white p-8 rounded-lg border border-gray-200 text-center shadow-sm">
        <h3 class="text-lg font-medium text-gray-900 mb-2">No Open Challenges</h3>
        <p class="text-gray-500">There are currently no open innovation challenges published.</p>
    </div>
<% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% challenges.forEach(challenge => { %>
            <div class="bg-white rounded-lg border border-gray-200 shadow-sm flex flex-col overflow-hidden hover:shadow-md transition-shadow">
                <div class="p-6 flex-grow">
                    <div class="flex justify-between items-start mb-4">
                        <span class="inline-block px-2 py-1 text-xs font-semibold rounded bg-blue-100 text-blue-800">
                            <%= challenge.sector || 'Innovation' %>
                        </span>
                        <% if (challenge.deadline) { %>
                            <span class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded border border-gray-200">
                                Due: <%= new Date(challenge.deadline).toLocaleDateString() %>
                            </span>
                        <% } %>
                    </div>
                    
                    <h3 class="text-lg font-bold text-gray-900 mb-2 line-clamp-2">
                        <%= challenge.title %>
                    </h3>
                    
                    <p class="text-sm text-gray-600 mb-4 line-clamp-3">
                        <%= challenge.problemStatement %>
                    </p>
                    
                    <div class="mt-auto space-y-2 text-sm text-gray-500">
                        <div class="flex items-center gap-2">
                            <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
                            <%= challenge.department ? challenge.department.name : 'Government Dept' %>
                        </div>
                        <div class="flex items-center gap-2">
                            <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            <%= challenge.budgetMin && challenge.budgetMax ? `$${challenge.budgetMin.toLocaleString()} - $${challenge.budgetMax.toLocaleString()}` : 'Budget TBD' %>
                        </div>
                    </div>
                </div>
                
                <div class="bg-gray-50 p-4 border-t border-gray-200">
                    <a href="/challenges/<%= challenge._id %>" class="block w-full text-center bg-white border border-gray-300 text-gray-700 py-2 px-4 rounded font-medium hover:bg-gray-50 transition-colors">
                        View Challenge
                    </a>
                </div>
            </div>
        <% }) %>
    </div>
<% } %>
