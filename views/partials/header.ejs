<header class="bg-white shadow-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center">
            <a href="/" class="flex items-center gap-2">
                <div class="w-8 h-8 bg-primary rounded-md flex items-center justify-center text-white font-bold">GP</div>
                <span class="text-xl font-bold text-gray-900">GovPilot</span>
            </a>
        </div>
        <div class="flex items-center gap-4">
            <% if (user) { %>
                <span class="text-sm text-gray-600 font-medium">Hello, <%= user.name %> (<%= user.role %>)</span>
                <a href="/auth/logout" class="text-sm text-red-600 hover:text-red-800 font-medium px-3 py-1 rounded border border-red-200 hover:bg-red-50 transition-colors">Logout</a>
            <% } else { %>
                <a href="/auth/login" class="text-sm bg-primary text-white hover:bg-blue-700 font-medium px-4 py-2 rounded shadow transition-colors">Login</a>
            <% } %>
        </div>
    </div>
</header>
