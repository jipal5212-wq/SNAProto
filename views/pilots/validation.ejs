<div class="mb-6">
    <a href="/government/pilots/<%= pilot._id %>" class="text-sm text-primary hover:underline flex items-center gap-1 mb-4">
        &larr; Back to Pilot Dashboard
    </a>
    <h1 class="text-2xl font-bold text-gray-900">Pilot Validation</h1>
    <p class="text-gray-500 mt-1">Review pilot performance and make a final recommendation.</p>
</div>

<div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 max-w-3xl mx-auto">
    <div class="mb-8 p-4 bg-gray-50 rounded-lg border border-gray-200">
        <h3 class="font-bold text-gray-900 mb-2">KPI Summary</h3>
        <ul class="space-y-2">
            <% pilot.kpis.forEach(kpi => { 
                const latest = kpi.actualValues.length > 0 ? kpi.actualValues[kpi.actualValues.length - 1].value : kpi.baseline;
            %>
                <li class="text-sm flex justify-between">
                    <span class="text-gray-700"><%= kpi.name %>:</span>
                    <span class="font-medium text-gray-900">
                        Baseline: <%= kpi.baseline %> &rarr; Actual: <%= latest %> 
                        (Target: <%= kpi.target %>)
                    </span>
                </li>
            <% }) %>
        </ul>
    </div>

    <form action="/government/pilots/<%= pilot._id %>/validation" method="POST" class="space-y-6">
        
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Validation Decision *</label>
            <div class="space-y-3">
                <label class="flex items-start">
                    <input type="radio" name="validationStatus" value="VALIDATED" required class="mt-1 h-4 w-4 text-primary focus:ring-primary border-gray-300">
                    <div class="ml-3">
                        <span class="block text-sm font-medium text-gray-900">Validated</span>
                        <span class="block text-sm text-gray-500">Pilot fully succeeded and met KPIs.</span>
                    </div>
                </label>
                <label class="flex items-start">
                    <input type="radio" name="validationStatus" value="PARTIALLY_VALIDATED" class="mt-1 h-4 w-4 text-primary focus:ring-primary border-gray-300">
                    <div class="ml-3">
                        <span class="block text-sm font-medium text-gray-900">Partially Validated</span>
                        <span class="block text-sm text-gray-500">Pilot showed promise but missed some targets.</span>
                    </div>
                </label>
                <label class="flex items-start">
                    <input type="radio" name="validationStatus" value="NOT_VALIDATED" class="mt-1 h-4 w-4 text-primary focus:ring-primary border-gray-300">
                    <div class="ml-3">
                        <span class="block text-sm font-medium text-gray-900">Not Validated</span>
                        <span class="block text-sm text-gray-500">Pilot failed to meet required targets.</span>
                    </div>
                </label>
            </div>
        </div>

        <div>
            <label for="kpiAchievement" class="block text-sm font-medium text-gray-700 mb-1">KPI Achievement Summary</label>
            <textarea id="kpiAchievement" name="kpiAchievement" rows="2" class="w-full border border-gray-300 rounded-md p-2" placeholder="Briefly summarize KPI success/failure..."></textarea>
        </div>

        <div>
            <label for="comments" class="block text-sm font-medium text-gray-700 mb-1">Evaluator Comments</label>
            <textarea id="comments" name="comments" rows="3" class="w-full border border-gray-300 rounded-md p-2" placeholder="Additional observations..."></textarea>
        </div>
        
        <div class="bg-blue-50 p-4 rounded-md border border-blue-200 flex items-start">
            <div class="flex items-center h-5">
                <input id="generateRecommendation" name="generateRecommendation" type="checkbox" checked class="focus:ring-primary h-4 w-4 text-primary border-gray-300 rounded">
            </div>
            <div class="ml-3 text-sm">
                <label for="generateRecommendation" class="font-bold text-blue-900">Auto-Generate Scale-Up Recommendation</label>
                <p class="text-blue-800 mt-1">Use the rule-based engine to generate a recommendation (SCALE UP, EXTEND, or STOP) based on the validation decision.</p>
            </div>
        </div>

        <div class="pt-4 border-t border-gray-200 flex justify-end">
            <button type="submit" class="bg-primary text-white px-6 py-2 rounded-md font-medium hover:bg-blue-700 transition-colors">
                Finalize Validation
            </button>
        </div>
    </form>
</div>
