<div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Startup Dashboard</h1>
    <p class="text-gray-500 mt-1">Discover challenges, track applications, and manage pilots.</p>
</div>

<% if (!isProfileComplete) { %>
    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-8 rounded-r-md">
        <div class="flex">
            <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-yellow-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                </svg>
            </div>
            <div class="ml-3">
                <p class="text-sm text-yellow-700">
                    Your profile is incomplete. <a href="/startup/profile" class="font-bold underline hover:text-yellow-600">Complete it now</a> to get accurate AI recommendations for government challenges.
                </p>
            </div>
        </div>
    </div>
<% } %>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    
    <!-- Recommended Challenges -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
            <h2 class="text-lg font-bold text-gray-900 flex items-center gap-2">
                <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
                AI Recommended Challenges
            </h2>
            <a href="/challenges" class="text-sm text-primary hover:underline">View All</a>
        </div>
        
        <ul class="divide-y divide-gray-200">
            <% if (recommendedChallenges.length === 0) { %>
                <li class="p-6 text-center text-gray-500">No recommendations available. Complete your profile or check back later.</li>
            <% } else { %>
                <% recommendedChallenges.forEach(item => { %>
                    <li class="p-6 hover:bg-gray-50 transition-colors">
                        <div class="flex justify-between items-start mb-2">
                            <a href="/challenges/<%= item.challenge._id %>" class="text-base font-bold text-gray-900 hover:text-primary"><%= item.challenge.title %></a>
                            <span class="inline-flex items-center justify-center px-2 py-1 rounded text-xs font-bold <%= item.score > 75 ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                                <%= item.score %>% Match
                            </span>
                        </div>
                        <p class="text-sm text-gray-500 mb-3 line-clamp-2"><%= item.challenge.problemStatement %></p>
                        <div class="flex justify-between items-center mt-4 pt-4 border-t border-gray-100">
                            <span class="text-xs text-gray-400">Deadline: <%= item.challenge.deadline ? new Date(item.challenge.deadline).toLocaleDateString() : 'N/A' %></span>
                            <a href="/challenges/<%= item.challenge._id %>" class="text-sm font-medium text-primary hover:underline">View Details &rarr;</a>
                        </div>
                    </li>
                <% }) %>
            <% } %>
        </ul>
    </div>

    <div class="space-y-8">
        <!-- Active Pilots -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
                <h2 class="text-lg font-bold text-gray-900">Active Pilots</h2>
                <a href="/startup/pilots" class="text-sm text-primary hover:underline">View All</a>
            </div>
            <ul class="divide-y divide-gray-200">
                <% if (activePilots.length === 0) { %>
                    <li class="p-6 text-center text-gray-500">No active pilots. Apply to challenges to get selected!</li>
                <% } else { %>
                    <% activePilots.forEach(pilot => { %>
                        <li class="p-4 hover:bg-gray-50">
                            <div class="flex justify-between items-start">
                                <div>
                                    <a href="/startup/pilots/<%= pilot._id %>" class="text-sm font-medium text-gray-900 hover:text-primary block mb-1"><%= pilot.objective %></a>
                                    <span class="text-xs text-gray-500"><%= pilot.department ? pilot.department.name : '' %></span>
                                </div>
                                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800"><%= pilot.status.replace(/_/g, ' ') %></span>
                            </div>
                        </li>
                    <% }) %>
                <% } %>
            </ul>
        </div>

        <!-- Recent Applications -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
                <h2 class="text-lg font-bold text-gray-900">Recent Applications</h2>
                <a href="/startup/applications" class="text-sm text-primary hover:underline">View All</a>
            </div>
            <ul class="divide-y divide-gray-200">
                <% if (applications.length === 0) { %>
                    <li class="p-6 text-center text-gray-500">You haven't submitted any applications.</li>
                <% } else { %>
                    <% applications.forEach(app => { %>
                        <li class="p-4 hover:bg-gray-50">
                            <div class="flex justify-between items-center">
                                <a href="/challenges/<%= app.challenge._id %>" class="text-sm font-medium text-gray-900 hover:text-primary line-clamp-1"><%= app.challenge.title %></a>
                                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800 ml-2 whitespace-nowrap"><%= app.status %></span>
                            </div>
                        </li>
                    <% }) %>
                <% } %>
            </ul>
        </div>
    </div>
</div>
