<div class="mb-6">
    <h1 class="text-3xl font-bold text-gray-900">Government Dashboard</h1>
    <p class="text-gray-500 mt-1">Overview of innovation challenges and pilots.</p>
</div>

<!-- Stats -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 flex items-center">
        <div class="p-3 rounded-full bg-blue-100 text-primary mr-4">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
        </div>
        <div>
            <p class="text-sm font-medium text-gray-500 uppercase">Total Challenges</p>
            <p class="text-2xl font-bold text-gray-900"><%= stats.totalChallenges %></p>
        </div>
    </div>
    
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 flex items-center">
        <div class="p-3 rounded-full bg-purple-100 text-purple-600 mr-4">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
        </div>
        <div>
            <p class="text-sm font-medium text-gray-500 uppercase">Applications</p>
            <p class="text-2xl font-bold text-gray-900"><%= stats.totalApplications %></p>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 flex items-center">
        <div class="p-3 rounded-full bg-yellow-100 text-yellow-600 mr-4">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
        </div>
        <div>
            <p class="text-sm font-medium text-gray-500 uppercase">Active Pilots</p>
            <p class="text-2xl font-bold text-gray-900"><%= stats.activePilots %></p>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6 flex items-center">
        <div class="p-3 rounded-full bg-green-100 text-green-600 mr-4">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>
        </div>
        <div>
            <p class="text-sm font-medium text-gray-500 uppercase">Ready to Scale</p>
            <p class="text-2xl font-bold text-gray-900"><%= stats.successfulPilots %></p>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Recent Challenges -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
            <h2 class="text-lg font-bold text-gray-900">Recent Challenges</h2>
            <a href="/government/challenges" class="text-sm text-primary hover:underline">View All</a>
        </div>
        <ul class="divide-y divide-gray-200">
            <% if (recentChallenges.length === 0) { %>
                <li class="p-6 text-center text-gray-500">No challenges created yet.</li>
            <% } else { %>
                <% recentChallenges.forEach(challenge => { %>
                    <li class="p-4 hover:bg-gray-50">
                        <div class="flex justify-between items-center">
                            <a href="/government/challenges/<%= challenge._id %>" class="text-sm font-medium text-gray-900 hover:text-primary"><%= challenge.title %></a>
                            <span class="px-2 py-1 text-xs font-semibold rounded-full <%= challenge.status === 'PUBLISHED' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>"><%= challenge.status %></span>
                        </div>
                    </li>
                <% }) %>
            <% } %>
        </ul>
    </div>

    <!-- Active Pilots -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-200 bg-gray-50 flex justify-between items-center">
            <h2 class="text-lg font-bold text-gray-900">Recent Pilots</h2>
            <a href="/government/pilots" class="text-sm text-primary hover:underline">View All</a>
        </div>
        <ul class="divide-y divide-gray-200">
            <% if (recentPilots.length === 0) { %>
                <li class="p-6 text-center text-gray-500">No pilots created yet.</li>
            <% } else { %>
                <% recentPilots.forEach(pilot => { %>
                    <li class="p-4 hover:bg-gray-50">
                        <div class="flex justify-between items-start">
                            <div>
                                <a href="/government/pilots/<%= pilot._id %>" class="text-sm font-medium text-gray-900 hover:text-primary block mb-1 line-clamp-1"><%= pilot.objective %></a>
                                <span class="text-xs text-gray-500"><%= pilot.startup ? pilot.startup.name : 'Unknown' %></span>
                            </div>
                            <span class="px-2 py-1 text-xs font-semibold rounded-full bg-blue-100 text-blue-800 whitespace-nowrap ml-2"><%= pilot.status.replace(/_/g, ' ') %></span>
                        </div>
                    </li>
                <% }) %>
            <% } %>
        </ul>
    </div>
</div>

<!-- Process Diagram -->
<div class="mt-8 bg-white rounded-lg shadow-sm border border-gray-200 p-6">
    <h2 class="text-lg font-bold text-gray-900 mb-6 text-center">Innovation Lifecycle Workflow</h2>
    <div class="flex flex-col md:flex-row justify-between items-center relative max-w-4xl mx-auto">
        <!-- Connecting Line -->
        <div class="hidden md:block absolute top-1/2 left-0 w-full h-1 bg-gray-200 -z-10 -translate-y-1/2"></div>
        
        <!-- Steps -->
        <div class="flex flex-col items-center bg-white p-2">
            <div class="w-12 h-12 rounded-full bg-blue-100 text-primary flex items-center justify-center font-bold text-lg mb-2 shadow-sm border-2 border-white">1</div>
            <span class="text-xs font-bold text-gray-600 uppercase">Define Problem</span>
        </div>
        <div class="flex flex-col items-center bg-white p-2 mt-4 md:mt-0">
            <div class="w-12 h-12 rounded-full bg-blue-100 text-primary flex items-center justify-center font-bold text-lg mb-2 shadow-sm border-2 border-white">2</div>
            <span class="text-xs font-bold text-gray-600 uppercase">Discover Match</span>
        </div>
        <div class="flex flex-col items-center bg-white p-2 mt-4 md:mt-0">
            <div class="w-12 h-12 rounded-full bg-blue-100 text-primary flex items-center justify-center font-bold text-lg mb-2 shadow-sm border-2 border-white">3</div>
            <span class="text-xs font-bold text-gray-600 uppercase">Evaluate Solutions</span>
        </div>
        <div class="flex flex-col items-center bg-white p-2 mt-4 md:mt-0">
            <div class="w-12 h-12 rounded-full bg-blue-100 text-primary flex items-center justify-center font-bold text-lg mb-2 shadow-sm border-2 border-white">4</div>
            <span class="text-xs font-bold text-gray-600 uppercase">Run Pilot</span>
        </div>
        <div class="flex flex-col items-center bg-white p-2 mt-4 md:mt-0">
            <div class="w-12 h-12 rounded-full bg-green-100 text-green-600 flex items-center justify-center font-bold text-lg mb-2 shadow-sm border-2 border-white">5</div>
            <span class="text-xs font-bold text-gray-600 uppercase">Scale Up</span>
        </div>
    </div>
</div>
