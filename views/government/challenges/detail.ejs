<div class="mb-6">
    <a href="/government/challenges" class="text-sm text-primary hover:underline flex items-center gap-1 mb-4">
        &larr; Back to Challenges
    </a>
    
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
        <div>
            <span class="inline-block px-2 py-1 text-xs font-semibold rounded bg-blue-100 text-blue-800 mb-2">
                <%= challenge.sector || 'Innovation' %>
            </span>
            <h1 class="text-3xl font-bold text-gray-900"><%= challenge.title %></h1>
            <p class="text-gray-500 mt-1">Published by: <%= challenge.department ? challenge.department.name : 'Unknown Department' %></p>
        </div>
        
        <div class="flex gap-3">
            <% if (challenge.status === 'DRAFT') { %>
                <form action="/government/challenges/<%= challenge._id %>/publish" method="POST" class="inline">
                    <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded-md font-medium shadow-sm hover:bg-green-700 transition-colors">
                        Publish Challenge
                    </button>
                </form>
            <% } %>
            <a href="/government/challenges/<%= challenge._id %>/applications" class="bg-primary text-white px-4 py-2 rounded-md font-medium shadow-sm hover:bg-blue-700 transition-colors">
                View Applications
            </a>
            <a href="/government/challenges/<%= challenge._id %>/ranking" class="bg-indigo-600 text-white px-4 py-2 rounded-md font-medium shadow-sm hover:bg-indigo-700 transition-colors">
                Rankings
            </a>
            <a href="/rag?challengeId=<%= challenge._id %>" class="bg-gradient-to-r from-purple-600 to-indigo-600 text-white px-4 py-2 rounded-md font-medium shadow-sm hover:from-purple-700 hover:to-indigo-700 transition-colors flex items-center gap-1.5">
                <span>⚡ AI RAG Workspace</span>
            </a>
        </div>
    </div>
</div>

<div class="flex items-center gap-2 mb-6">
    <% if (challenge.status === 'PUBLISHED') { %>
        <span class="px-3 py-1 text-sm font-bold rounded-full bg-green-100 text-green-800">PUBLISHED</span>
    <% } else if (challenge.status === 'DRAFT') { %>
        <span class="px-3 py-1 text-sm font-bold rounded-full bg-yellow-100 text-yellow-800">DRAFT</span>
    <% } else { %>
        <span class="px-3 py-1 text-sm font-bold rounded-full bg-gray-100 text-gray-800"><%= challenge.status %></span>
    <% } %>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <div class="lg:col-span-2 space-y-6">
        <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4 pb-2 border-b border-gray-100">The Problem</h2>
            <p class="text-gray-700 whitespace-pre-wrap"><%= challenge.problemStatement || challenge.rawProblem %></p>
        </div>
        
        <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4 pb-2 border-b border-gray-100">Desired Outcome</h2>
            <p class="text-gray-700"><%= challenge.desiredOutcome %></p>
            <% if (challenge.target) { %>
                <div class="mt-4 bg-gray-50 p-4 border-l-4 border-primary rounded-r">
                    <strong>Target:</strong> <%= challenge.target %>
                </div>
            <% } %>
        </div>

        <% if (challenge.kpis && challenge.kpis.length > 0) { %>
            <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
                <h2 class="text-xl font-bold text-gray-900 mb-4 pb-2 border-b border-gray-100">KPIs</h2>
                <ul class="list-disc pl-5 space-y-2 text-gray-700">
                    <% challenge.kpis.forEach(kpi => { %>
                        <li><%= kpi %></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>
    </div>

    <div class="space-y-6">
        <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
            <h3 class="text-lg font-bold text-gray-900 mb-4">Challenge Details</h3>
            <dl class="space-y-4">
                <div>
                    <dt class="text-sm font-medium text-gray-500">Budget Range</dt>
                    <dd class="mt-1 text-sm text-gray-900 font-semibold">
                        <%= challenge.budgetMin && challenge.budgetMax ? `$${challenge.budgetMin.toLocaleString()} - $${challenge.budgetMax.toLocaleString()}` : 'Not Specified' %>
                    </dd>
                </div>
                <div>
                    <dt class="text-sm font-medium text-gray-500">Pilot Duration</dt>
                    <dd class="mt-1 text-sm text-gray-900 font-semibold"><%= challenge.pilotDuration || 'Not Specified' %></dd>
                </div>
                <% if (challenge.deadline) { %>
                    <div>
                        <dt class="text-sm font-medium text-gray-500">Deadline</dt>
                        <dd class="mt-1 text-sm text-red-600 font-semibold"><%= new Date(challenge.deadline).toLocaleDateString() %></dd>
                    </div>
                <% } %>
            </dl>
        </div>
        
        <% if (challenge.technologies && challenge.technologies.length > 0) { %>
            <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
                <h3 class="text-lg font-bold text-gray-900 mb-3">Technologies</h3>
                <div class="flex flex-wrap gap-2">
                    <% challenge.technologies.forEach(tech => { %>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 border border-gray-200"><%= tech %></span>
                    <% }) %>
                </div>
            </div>
        <% } %>

        <% if (challenge.requiredCapabilities && challenge.requiredCapabilities.length > 0) { %>
            <div class="bg-white rounded-lg border border-gray-200 shadow-sm p-6">
                <h3 class="text-lg font-bold text-gray-900 mb-3">Required Capabilities</h3>
                <div class="flex flex-wrap gap-2">
                    <% challenge.requiredCapabilities.forEach(cap => { %>
                        <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-indigo-100 text-indigo-800 border border-indigo-200"><%= cap %></span>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </div>
</div>
